# =====================================================================
# USapp 阶段 0 环境变量样例
# 复制为 .env 后由负责人本地填写。真实密钥不得提交到仓库。
# 变量名与 services/api/src/config、apps/*、services/push-worker/src/config.ts
# 以及 deploy/docker-compose.yml 保持一致；改名必须三处同时改。
# =====================================================================

# ---------- 运行环境 ----------
APP_ENV=development                 # development | production
APP_VERSION=0.1.0

# ---------- 同源与来源校验 ----------
# 状态修改请求必须精确匹配该 Origin（字符串完全相等，含协议与端口）
PUBLIC_ORIGIN=https://localhost:8443
# 管理入口 Origin（仅回环）
ADMIN_ORIGIN=https://localhost:8444

# ---------- 监听地址 ----------
API_PUBLIC_BIND=0.0.0.0
API_PUBLIC_PORT=8080
# 管理入口必须绑定回环地址
API_ADMIN_BIND=127.0.0.1
API_ADMIN_PORT=8081

# 管理面应用层额外边界：允许的管理来源 CIDR（逗号分隔）。
# 部署中 Caddy 作为同机受信代理时，需要把 compose 网段加入这里。
# 生产默认只允许回环 + 受信代理网段，禁止 0.0.0.0/0。
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.28.0.0/16

# ---------- PostgreSQL 17 ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=usapp
POSTGRES_USER=usapp_api
POSTGRES_PASSWORD=change-me-locally
# 并发连接数（Drogon db_clients）
POSTGRES_POOL_SIZE=8

# 集群超级用户（仅容器初始化与负责人执行 DDL 迁移/备份恢复时使用，应用运行时绝不使用）
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-locally

# 推送辅助进程运行账户（受限账户，仅拥有推送队列表权限，严禁访问核心业务表）
POSTGRES_PUSH_USER=usapp_push
POSTGRES_PUSH_PASSWORD=change-me-locally

# ---------- 注册策略（阶段 0 硬约束） ----------
# REGISTRATION_MODE 只允许 WHITELIST；白名单只控制新账号注册，不定义业务权限
REGISTRATION_MODE=WHITELIST
ALLOWED_EMAILS=you@example.com,partner@example.com

# ---------- 邮箱验证码 ----------
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
# 每个邮箱每小时最多发送次数
EMAIL_CODE_HOURLY_LIMIT=8

# ---------- 会话 ----------
# 预认证会话（登录前）TTL
PREAUTH_SESSION_TTL_SECONDS=1800
AUTH_SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_NAME=__Host-usapp-session
ADMIN_SESSION_COOKIE_NAME=__Host-usapp-admin
# 会话令牌/CSRF/邀请码的 HMAC 密钥（>=32 字节随机值）
SESSION_SECRET=change-me-locally-32-bytes-minimum

# ---------- 邮件发送 ----------
# log = 只写日志（本地开发，不发送真实邮件）
# smtp = 真实投递
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true

# ---------- 调度（C++ 主进程内，阶段 0 只有基础） ----------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL_MS=15000
# 实例标识，用于日志与 scheduler_ticks 记录；同一时刻只有一个实例持有锁
SCHEDULER_INSTANCE_ID=
# 调度任务 key 的命名空间；跨实例必须完全一致，改动等同于换锁
SCHEDULER_KEY_NAMESPACE=usapp.scheduler
# P2-6 R2：应用内提醒生成，默认关闭。开启前数据库必须已应用 0026，否则该任务失败并不写入。
REMINDERS_ENABLED=false
# D6 M1d：到期后不可逆地擦除已删除回忆的文字，默认关闭。没有外部删除日志和恢复演练不得在生产开启。开启前数据库必须已应用 0039。
# Startup refuses true until a durable journal provider and recovery authority are integrated (docs/deletion-startup-refusal.md).
MEMORY_PURGE_ENABLED=false

# ---------- 管理后台认证（独立于情侣账号） ----------
# 首次启动由负责人手动初始化管理员（见 docs/phase0-handoff.md）
# ADMIN_BOOTSTRAP_PASSWORD_HASH 格式要求：pbkdf2-sha256$<iterations>$<salt-b64>$<hash-b64>
# 生成示例 (Node.js)：
#   node -e 'const c=require("crypto"),s=c.randomBytes(16),h=c.pbkdf2Sync("YOUR_PASSWORD",s,600000,32,"sha256");console.log(`pbkdf2-sha256$600000$${s.toString("base64")}$${h.toString("base64")}`)'
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# ---------- 私有媒体（阶段 3，默认关闭）----------
# Only requests real storage when true. Incomplete config OR the missing durable journal adapter now refuses startup.
# This is a refusal layer, not completed J3c or permission to reopen restored data; see docs/deletion-startup-refusal.md.
# 三个身份必须不同。厂商保证尚未在真实 OSS 上验证，真实照片在删除策略实现前不得上传。
MEDIA_ENABLED=false
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_UPLOAD_KEY_ID=
OSS_UPLOAD_KEY_SECRET=
OSS_READ_KEY_ID=
OSS_READ_KEY_SECRET=
OSS_SERVER_KEY_ID=
OSS_SERVER_KEY_SECRET=

# ---------- 推送辅助进程 ----------
PUSH_ENABLED=false
PUSH_SUBSCRIBE_ENABLED=false
PUSH_WORKER_ENABLED=false
PUSH_WORKER_HOST=127.0.0.1
PUSH_WORKER_PORT=8090
PUSH_WORKER_TOKEN=
# 阶段 0 不接入真实推送服务
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------- 数据库备份（负责人手动执行） ----------
BACKUP_DIR=./backups
