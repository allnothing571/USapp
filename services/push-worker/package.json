{
  "name": "@usapp/push-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "USapp push worker: a stateless authenticated Web Push transport with no database access",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "~5.9.2"
  }
}
