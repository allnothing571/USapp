# =====================================================================
# USapp Production Environment Template
# Copy to repository root as `.env` on the VPS: cp deploy/env.prod.example .env
# Generate strong random secrets with: node deploy/scripts/gen-secrets.mjs
# =====================================================================

# ---------- Domain & TLS (Caddy auto Let's Encrypt) ----------
PUBLIC_DOMAIN=us.example.com
ACME_EMAIL=you@example.com
ADMIN_ORIGIN=https://localhost:8444
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.28.0.0/16

# ---------- GHCR Images ----------
GHCR_IMAGE_PREFIX=ghcr.io/allnothing571/usapp
IMAGE_TAG=latest
APP_VERSION=1.0.0

# ---------- Couple Whitelist ----------
REGISTRATION_MODE=WHITELIST
ALLOWED_EMAILS=you@example.com,partner@example.com

# ---------- PostgreSQL 17 ----------
POSTGRES_DB=usapp
POSTGRES_USER=usapp_api
POSTGRES_PASSWORD=replace-with-gen-secrets
POSTGRES_POOL_SIZE=8
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-with-gen-secrets
POSTGRES_PUSH_USER=usapp_push
POSTGRES_PUSH_PASSWORD=replace-with-gen-secrets

# ---------- Sessions & Auth Codes ----------
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_HOURLY_LIMIT=8
PREAUTH_SESSION_TTL_SECONDS=1800
AUTH_SESSION_TTL_SECONDS=2592000
SESSION_SECRET=replace-with-gen-secrets

# ---------- SMTP Email Login ----------
MAIL_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=apikey-or-account
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true

# ---------- Scheduler & Features ----------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL_MS=15000
SCHEDULER_INSTANCE_ID=vps-1
SCHEDULER_KEY_NAMESPACE=usapp.scheduler
REMINDERS_ENABLED=true
# Keep false until durable deletion journal adapter is wired in C++ main:
MEMORY_PURGE_ENABLED=false
MEDIA_ENABLED=false

# ---------- Admin Bootstrap ----------
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=replace-with-gen-secrets

# ---------- Web Push ----------
PUSH_ENABLED=true
PUSH_SUBSCRIBE_ENABLED=true
PUSH_WORKER_ENABLED=true
PUSH_WORKER_TOKEN=replace-with-gen-secrets
VAPID_PUBLIC_KEY=replace-with-gen-secrets
VAPID_PRIVATE_KEY=replace-with-gen-secrets
VAPID_SUBJECT=mailto:you@example.com

# ---------- Encrypted Daily Backup ----------
BACKUP_DIR=./backups
BACKUP_PASSPHRASE=replace-with-gen-secrets
BACKUP_RETENTION_DAYS=30
