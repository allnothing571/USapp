# =====================================================================
# USapp push-worker 镜像（Node.js 24 / TypeScript）—— P2-5c
#
# 无状态、经认证的内部传输进程：不含数据库凭证，不做业务判断。
# 构建上下文：仓库根目录（docker-compose.yml 中 context: ..）。
# 依赖版本由 services/push-worker/pnpm-lock.yaml 固定（--frozen-lockfile）。
#
# 目标：
#   tester   —— 含测试产物与仅测试用材料，只用于隔离网络验证，绝不部署
#   runtime  —— 生产镜像（默认目标）：只含 dist/src 与生产依赖，不含 tests
# =====================================================================

# ---------------------------------------------------------------------
# 阶段 1：编译（含 tests）
# ---------------------------------------------------------------------
FROM node:24-alpine AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

COPY services/push-worker/package.json /app/package.json
COPY services/push-worker/tsconfig.json /app/tsconfig.json
COPY services/push-worker/pnpm-lock.yaml /app/pnpm-lock.yaml

RUN pnpm install --frozen-lockfile

COPY services/push-worker/src /app/src
COPY services/push-worker/tests /app/tests

RUN pnpm run build

# ---------------------------------------------------------------------
# 阶段：隔离测试（仅 docker-compose.test-p25c.yml 使用）
# ---------------------------------------------------------------------
FROM builder AS tester

ENV NODE_ENV=test
USER node
EXPOSE 8090
CMD ["node", "dist/tests/smoke-server.js"]

# ---------------------------------------------------------------------
# 阶段：只安装生产依赖
# ---------------------------------------------------------------------
FROM node:24-alpine AS prod-deps

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

COPY services/push-worker/package.json /app/package.json
COPY services/push-worker/pnpm-lock.yaml /app/pnpm-lock.yaml

RUN pnpm install --prod --frozen-lockfile

# ---------------------------------------------------------------------
# 阶段 2：运行
# ---------------------------------------------------------------------
FROM node:24-alpine AS runtime

ENV NODE_ENV=production

WORKDIR /app

# 只复制运行所需内容：生产依赖（各依赖包自带的许可文件随之保留）、src 的编译产物、第三方声明。
COPY --from=prod-deps /app/package.json /app/package.json
COPY --from=prod-deps /app/node_modules /app/node_modules
COPY --from=builder /app/dist/src /app/dist/src
COPY services/push-worker/THIRD_PARTY_NOTICES.md /app/THIRD_PARTY_NOTICES.md
COPY services/push-worker/licenses /app/licenses

# 官方 node 镜像自带非特权用户 node（uid 1000），直接使用，无需再建用户。
USER node

# 只在容器私有网络内监听，compose 不发布该端口（见 docker-compose.yml）。
EXPOSE 8090

# 直接用 node 启动，不经过 pnpm/corepack，减少运行期依赖。
CMD ["node", "dist/src/index.js"]
