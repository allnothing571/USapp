{
	admin off
	auto_https disable_redirects
}

https://localhost:18443 {
	tls internal
	request_header -X-Usapp-Admin-Surface
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://usapp-p31d-test-71.oss-cn-shanghai.aliyuncs.com; connect-src 'self' https://usapp-p31d-test-71.oss-cn-shanghai.aliyuncs.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Cache-Control no-store
	}
	handle /api/v1/* {
		reverse_proxy api:8080
	}
	handle /api/* {
		respond 404
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
